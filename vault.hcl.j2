# =============================================================================
# roles/vault-server/templates/vault.hcl.j2
# HashiCorp Vault server configuration.
# File storage backend — appropriate for single-node dev/staging Vault.
# =============================================================================

ui = true

storage "file" {
  path = "{{ vault_data_dir }}"
}

listener "tcp" {
  address       = "0.0.0.0:{{ vault_port }}"
  tls_disable   = {{ vault_tls_disable | lower }}
  {% if not vault_tls_disable %}
  tls_cert_file = "{{ vault_tls_cert }}"
  tls_key_file  = "{{ vault_tls_key }}"
  {% endif %}
}

api_addr     = "http://{{ ansible_host }}:{{ vault_port }}"
cluster_addr = "http://{{ ansible_host }}:{{ vault_cluster_port }}"

log_level    = "info"
log_format   = "json"
disable_mlock = "true"
